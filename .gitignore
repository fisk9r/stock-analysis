# ---- 密钥：绝不入库，云端一律走 GitHub Secrets ----
config/notify.json
config/models.json
config/allowed_users.json
config/owner_pass.txt
# 持仓含私人成本/股数，绝不入库；网页端「编辑持仓」走 HOLDINGS_JSON 密钥写回。
# 模板 config/holdings.json.example 可入库。
config/holdings.json

# ---- 运行时生成的加密产物（由流水线在云端重建，不进 git） ----
dist/data/
dist/users.json
# 打包给 Pages 的暂存目录，每次重建（gitignore 不支持行尾注释，注释必须单独一行）
site/
# 线上体检时下载的样本
_livecheck/

# ---- 数据库：76MB，不进 git 历史；靠 Release asset 持久化 ----
cache/*.db
cache/*.db-journal
cache/*.db-wal
cache/*.db-shm
cache/market.db.gz
cache/state.tar.gz

# ---- 每日生成物：由流水线重建 + Release 状态包续存，不需要版本化 ----
dist/data.js
dist/data.js.bak
dist/push_log.jsonl
dist/last_push_*.md
archive/
news.json

# ---- 临时脚本与日志 ----
_*.py
*.log
logs/
tmp/
tmp/node_modules/

# ---- nacl.js 的上游源码与自检临时产物（bundle_nacl.js 会自动重新下载） ----
tools/naclbuild/tweetnacl.min.js
tools/naclbuild/b2b.js
tools/naclbuild/testkey.json
tools/naclbuild/sealed.json

# ---- 本地执行器：模拟盘账本不进 git（复盘数据经 runner 自动回传 state/sim_review.json） ----
tools/executor/sim.db
tools/executor/sim.db-journal
tools/executor/sim_test.db*
tools/executor/sim_review.json
tools/executor/risk_state.json
tools/executor/*.trash

# ---- 系统 ----
__pycache__/
*.pyc
.DS_Store
Thumbs.db
