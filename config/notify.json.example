{
  "_说明": "复制本文件为 notify.json，至少填写一种通道即可。未配置任何通道时，推送仅落地为 dist/last_push_*.md 文件痕迹。微信为首选。",
  "_微信推送（任选一种，免费）": {
    "企业微信群机器人(wecom)": "在企微群『添加群机器人』拿到 webhook 完整 URL，粘到 wecom.webhook。消息直接出现在微信里，最推荐。",
    "ServerChan(serverchan)": "https://sct.ftqq.com 用微信扫码登录拿 SendKey，填到 wechat_serverchan.sendkey。",
    "PushPlus(pushplus)": "https://www.pushplus.plus 注册拿 token，填到 wechat_pushplus.token。"
  },
  "_推送分级(scope，用户需求5)": "每个 sendkey/token 条目可加 scope 字段控制接收范围：all=全部信息(默认) / sim=仅模拟盘操作 / prepost=仅盘前盘后 / none=不接收。user 字段绑定到 allowed_users.json 的某用户（用于个性化复盘）。用 tools/manage_notify.py 自助管理。",
  "wechat_serverchan": {"sendkey": [
    {"key": "SCTxxxxxxxxxxxxxxxx", "name": "我", "user": "owner", "scope": "all"},
    {"key": "SCTyyyyyyyyyyyyyyyy", "name": "接收人2", "scope": "none"}
  ]},
  "wechat_pushplus":   {"token": [
    {"token": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx", "name": "我", "user": "owner", "scope": "all"},
    {"token": "yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy", "name": "接收人2", "scope": "none"}
  ]},
  "push_scope": {
    "enabled": false,
    "sections": { "holdings": true, "buy": true, "boards": true, "auction": true },
    "min_score": 55,
    "pool_limit": { "ladder": 4, "trend": 6, "band": 6 },
    "_note": "推送分层开关：enabled=true 后按 sections 显隐推送段落，min_score 过滤买点候选综合分，pool_limit 限制各池条数"
  },
  "wecom":             {"webhook": "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"},
  "telegram":          {"bot_token": "123456789:AAExxxxxxx", "chat_id": "-1001234567890"},
  "email":             {"smtp_host":"smtp.qq.com","smtp_port":465,"user":"you@qq.com","pass":"邮箱授权码(非密码)","to":"you@qq.com"}
}
